# Required for every scanner target request. Set your real key locally only.
ARMORIQ_API_KEY=
# DevOps MCP lab: required is the recommended enforced mode.
# Explicit disabled mode is local-policy-only and is not cloud enforcement.
MCP_ARMORIQ_MODE=required
MCP_SEMANTIC_MODE=disabled

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: legacy WAF AI features still use Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
